<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    The entire transformed state. The druid is not replaced by an animal pawn; this
    hediff sits on the colonist and carries the form, the stashed gear and the
    remaining duration. Removing it ends the shift, by any route.

    What lives here is what every form shares. Everything that depends on which animal
    was chosen - melee tools, move speed, durability - is derived at shift time in
    Druidkin.Hediff_WildShapeForm, because XML cannot name an animal chosen at runtime.
  -->
  <HediffDef>
    <defName>Druidkin_WildShapeForm</defName>
    <label>wild shaped</label>
    <description>This druid is wearing an animal's shape. They can move and fight, but their paws can do no work and hold no weapon.</description>
    <hediffClass>Druidkin.Hediff_WildShapeForm</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <tendable>false</tendable>
    <everCurableByItem>false</everCurableByItem>
    <maxSeverity>1.0</maxSeverity>

    <comps>
      <li Class="Druidkin.HediffCompProperties_WildShapeVerbs" />
    </comps>

    <stages>
      <li>
        <!--
          Work is blocked by tag rather than by zeroing Manipulation, which would be the
          obvious lever but is the wrong one: MeleeHitChance takes a capacity offset from
          Manipulation (scale 12, max 1.5), so zeroing it would cripple the combat form
          this exists to create. AllWork is its own flag and does not imply Violent, so
          the druid stays able to fight while being unable to work.
        -->
        <disabledWorkTags>
          <li>AllWork</li>
        </disabledWorkTags>
      </li>
    </stages>
  </HediffDef>

</Defs>

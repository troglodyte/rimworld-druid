  <!-- ===== Studded pieces (Medieval, Smithing; crafted via Recipes_Leatherworks.xml) ===== -->

  <ThingDef ParentName="LW_JerkinBase">
    <defName>LW_Apparel_StuddedLeatherJerkin</defName>
    <label>studded jerkin</label>
    <techLevel>Medieval</techLevel>
    <costList>
      <Steel>25</Steel>
    </costList>
    <statBases>
      <WorkToMake>9000</WorkToMake>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.05</MoveSpeed>
    </equippedStatOffsets>
    <comps>
      <li Class="Leatherworks.CompProperties_StuddedMetal" />
